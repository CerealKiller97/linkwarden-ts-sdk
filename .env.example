# Settings for the throwaway Linkwarden instance in docker-compose.yml.
#
# `scripts/dev-linkwarden.sh up` generates .env with random secrets automatically.
# To write it by hand instead: cp .env.example .env, then fill in the secrets
# (e.g. with `openssl rand -hex 32`).

# Public URL of the auth endpoint. Change the port if you change LINKWARDEN_PORT.
NEXTAUTH_URL=http://localhost:3000/api/v1/auth
# Secret used to sign sessions.
NEXTAUTH_SECRET=change-me

# Password for the bundled Postgres database.
POSTGRES_PASSWORD=change-me

# Master key for the bundled Meilisearch instance (search).
MEILI_MASTER_KEY=change-me

# Host port Linkwarden is published on.
LINKWARDEN_PORT=3000

# Linkwarden image tag to run. Defaults to the version pinned in .linkwarden-version,
# which CI tests against. Set it, e.g. to latest, to try another release.
# LINKWARDEN_VERSION=latest
